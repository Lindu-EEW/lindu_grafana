    {
      "id": 28,
      "title": "\ud83c\udfaf Evaluasi Akurasi TinyML (Kesepakatan AI vs Fisika Klasik)",
      "description": "Menampilkan validasi akurasi on-device AI (TinyML) terhadap algoritma fisika seismik klasik secara real-time.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lindu_pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lindu_pg"
          },
          "format": "table",
          "rawSql": "SELECT \n    node_id AS \"Node ID\",\n    round(avg(ml_prob*100)::numeric, 1) AS \"Prob Tenang (%)\",\n    round(max(ml_prob*100)::numeric, 1) AS \"Puncak Getaran (%)\",\n    round(100.0 * count(*) FILTER (WHERE ml_agree = true) / count(*), 1) AS \"Akurasi Kesepakatan (%)\",\n    CASE \n        WHEN round(100.0 * count(*) FILTER (WHERE ml_agree = true) / count(*), 1) >= 99.0 THEN '\ud83d\udfe2 SANGAT AKURAT (>=99%)'\n        ELSE '\ud83d\udfe1 CUKUP'\n    END AS \"Status AI\"\nFROM tb_sensor_telemetry\nWHERE $__timeFilter(ts) AND node_id IN ($node_id)\nGROUP BY node_id\nORDER BY node_id;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
