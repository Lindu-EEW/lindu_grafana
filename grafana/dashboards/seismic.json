      "id": 1
    },
    {
      "type": "timeseries",
      "title": "\ud83c\udf0a Grafik Seismogram Live (PGA)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lindu_pg"
          },
          "format": "time_series",
          "rawSql": "SELECT time_bucket('100ms', ts) AS time, node_id AS \"metric\", MAX(pga) AS \"PGA (g)\" FROM tb_sensor_telemetry WHERE $__timeFilter(ts) AND node_id IN ($node_id) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "g",
          "min": 0,
          "softMax": 0.03,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 12,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 3
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#FADE2A",
                "value": 0.008
              },
              {
                "color": "#F2495C",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lindu_pg"
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 2,
      "description": "Tenang < 0.008g (Ambient Noise Ruangan) \u00b7 Gempa Mikro 0.008g\u20130.020g \u00b7 Gempa Kuat >= 0.050g"
    },
