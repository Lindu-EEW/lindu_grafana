    {
      "id": 13,
      "title": "Interactive Command Center",
      "type": "text",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 68
      },
      "options": {
        "mode": "html",
        "content": "\n<div style=\"padding: 10px; background-color: #1a1b26; border-radius: 8px; border: 1px solid #2ac06d;\">\n  <h3 style=\"color: #2ac06d; margin-top: 0;\"><i class=\"fa fa-terminal\"></i> Command Center (Interactive)</h3>\n  <p style=\"color: #9aa5ce; font-size: 12px; margin-bottom: 15px;\">Send real-time commands to the ESP32 network directly from Grafana.</p>\n  \n  <div style=\"display: flex; gap: 10px; flex-wrap: wrap; background: #24283b; padding: 10px; border-radius: 4px; border: 1px solid #414868;\">\n    <p style=\"color: #9ece6a; margin: 0; font-size: 13px;\"><b>Target Aktif:</b> <span id=\"displayTarget\" style=\"color:white; font-family: monospace;\">$node_id</span> <i style=\"color:#9aa5ce; font-size:11px;\">(Mengikuti Dropdown di Atas)</i></p>\n  </div>\n  \n  <div style=\"display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap; background: #2d1b1b; padding: 10px; border-radius: 4px; border: 1px solid #f7768e;\">\n    <button onclick=\"if(confirm('Simulasikan alarm gempa CRITICAL (M6.5) sekarang? Ini akan membunyikan sirine node fisik & memicu banner di dashboard utama, tanpa perlu 2 node asli.')) sendCmd('simulate_quake')\" style=\"background: #f7768e; color: #1a1b26; font-weight: bold; border: none; padding: 12px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px; font-size: 14px;\">\ud83e\uddea SIMULASI GEMPA (DEBUG - TANPA 2 NODE)</button>\n  </div>\n  \n  <div style=\"display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap; background: #1f2335; padding: 10px; border-radius: 4px;\">\n    <input type=\"number\" id=\"newLat\" placeholder=\"New Latitude (e.g. -6.123)\" step=\"0.0001\" style=\"padding: 8px; background: #24283b; color: #fff; border: 1px solid #414868; border-radius: 4px; flex: 1; min-width: 150px; min-width: 100px;\">\n    <input type=\"number\" id=\"newLon\" placeholder=\"New Longitude (e.g. 106.123)\" step=\"0.0001\" style=\"padding: 8px; background: #24283b; color: #fff; border: 1px solid #414868; border-radius: 4px; flex: 1; min-width: 150px; min-width: 100px;\">\n    <button onclick=\"sendCmd('set_location')\" style=\"background: #bb9af7; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer;\"><i class=\"fa fa-map-marker\"></i> SET KOORDINAT BARU</button>\n  </div>\n            <div style=\"padding:10px; border:1px solid #73BF69; border-radius:5px; margin-bottom:10px; text-align:center;\">\n                <h4>\ud83c\udf10 Migrasi Server (Staging/Production)</h4>\n                <input type=\"text\" id=\"new_broker\" placeholder=\"mqtt.lindu-eew.com\" style=\"padding:5px; color:black;\">\n                <button onclick=\"sendCmd('set_broker')\" style=\"padding:5px 15px; background:#73BF69; color:white; border:none; border-radius:3px;\">MIGRATE TO NEW SERVER</button>\n            </div>\n            \n  \n  <div style=\"display: flex; gap: 10px; margin-top: 15px; flex-wrap: wrap;\">\n    <button onclick=\"sendCmd('enable_debug')\" style=\"background: #00E5FF; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-bug\"></i> ENABLE DEBUG LOG</button>\n    <button onclick=\"sendCmd('disable_debug')\" style=\"background: #414868; color: #ffffff; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-ban\"></i> DISABLE DEBUG</button>\n  </div>\n  <div style=\"display: flex; gap: 10px; margin-top: 15px; flex-wrap: wrap;\">\n    <button onclick=\"sendCmd('disable_valve')\" style=\"background: #f7768e; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-lock\"></i> LOCK VALVE</button>\n    <button onclick=\"sendCmd('enable_valve')\" style=\"background: #9ece6a; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-unlock\"></i> UNLOCK VALVE</button>\n  </div>\n  \n  <div style=\"display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;\">\n    <button onclick=\"sendCmd('identify')\" style=\"background: #e0af68; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-lightbulb-o\"></i> IDENTIFY NODE (BLINK WHITE)</button>\n    <button onclick=\"sendCmd('force_update')\" style=\"background: #7aa2f7; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-download\"></i> FORCE OTA UPDATE</button>\n  </div>\n  <div style=\"display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap; background: #1f2937; padding: 10px; border-radius: 4px; border: 1px solid #e0af68;\">\n    <button onclick=\"if(confirm('Reset nilai sensor PIR? Node akan dianggap TIDAK ADA gerakan/manusia terdeteksi sama sekali dalam 10 menit terakhir (dipakai untuk testing behavior door-lock saat sensor PIR belum terpasang secara fisik).')) sendCmd('reset_pir')\" style=\"background: #e0af68; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-refresh\"></i> RESET SENSOR PIR (Anggap 10 Menit Terakhir Tidak Ada Gerakan)</button>\n  </div>\n  <div style=\"display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;\">\n    <button onclick=\"if(confirm('Yakin mereset WiFi & LongLat? Alat akan offline.')) sendCmd('factory_reset')\" style=\"background: #f7768e; color: #ffffff; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-warning\"></i> FACTORY RESET NODE</button>\n  </div>\n  \n  <p id=\"cmdResult\" style=\"margin-top: 15px; font-family: monospace; font-size: 12px; color: #bb9af7;\"></p>\n</div>\n\n<script>\n  function sendCmd(command) {\n    let target = '$node_id';\n    if (target.includes(',')) { target = 'all'; } // If multiple nodes selected, broadcast to all\n    if (target.includes('__all') || target.toLowerCase() === 'all' || target === '') {\n        target = 'all';\n    }\n\n    const resultBox = document.getElementById('cmdResult');\n    resultBox.innerText = `Sending command '${command}' to '${target}'...`;\n    resultBox.style.color = '#e0af68';\n    \n    fetch('http://localhost:5050/api/cmd', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ cmd: command, target_node: target, lat: document.getElementById('newLat').value, lon: document.getElementById('newLon').value })\n    })\n    .then(res => res.json())\n    .then(data => {\n      if (data.status === 'success') {\n        resultBox.innerText = `[SUCCESS] Command sent to MQTT broker!`;\n        resultBox.style.color = '#9ece6a';\n      } else {\n        resultBox.innerText = `[ERROR] ${data.error}`;\n        resultBox.style.color = '#f7768e';\n      }\n    })\n    .catch(err => {\n      resultBox.innerText = `[NETWORK ERROR] Could not connect to API at localhost:5050.`;\n      resultBox.style.color = '#f7768e';\n    });\n  }\n</script>\n"
      },
      "transparent": true
    },
    {
      "type": "gauge",
      "title": "\ud83c\udf0a PGA Terkini (Peak Ground Acceleration)",
      "id": 20,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lindu_pg"
          },
          "format": "time_series",
          "rawSql": "SELECT ts AS \"time\", node_id AS \"metric\", pga FROM tb_sensor_telemetry WHERE ts >= NOW() - INTERVAL '5 seconds' AND node_id IN ($node_id) ORDER BY ts",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lindu_pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "g",
          "min": 0,
          "max": 0.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
