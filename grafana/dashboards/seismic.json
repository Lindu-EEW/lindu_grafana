    {
      "id": 13,
      "title": "Interactive Command Center",
      "type": "text",
      "gridPos": {
        "w": 24,
        "h": 9,
        "x": 0,
        "y": 63
      },
      "options": {
        "mode": "html",
        "content": "\n<div style=\"padding: 10px; background-color: #1a1b26; border-radius: 8px; border: 1px solid #2ac06d;\">\n  <h3 style=\"color: #2ac06d; margin-top: 0;\"><i class=\"fa fa-terminal\"></i> Command Center (Interactive)</h3>\n  <p style=\"color: #9aa5ce; font-size: 12px; margin-bottom: 15px;\">Send real-time commands to the ESP32 network directly from Grafana.</p>\n  \n  <div style=\"display: flex; gap: 10px; flex-wrap: wrap;\">\n    <input type=\"text\" id=\"targetNode\" placeholder=\"Target Node (e.g., node_3c096f0c atau all)\" value=\"all\" style=\"padding: 8px; background: #24283b; color: #fff; border: 1px solid #414868; border-radius: 4px; flex: 1; min-width: 150px; min-width: 200px;\">\n  </div>\n  \n  <div style=\"display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap; background: #1f2335; padding: 10px; border-radius: 4px;\">\n    <input type=\"number\" id=\"newLat\" placeholder=\"New Latitude (e.g. -6.123)\" step=\"0.0001\" style=\"padding: 8px; background: #24283b; color: #fff; border: 1px solid #414868; border-radius: 4px; flex: 1; min-width: 150px; min-width: 100px;\">\n    <input type=\"number\" id=\"newLon\" placeholder=\"New Longitude (e.g. 106.123)\" step=\"0.0001\" style=\"padding: 8px; background: #24283b; color: #fff; border: 1px solid #414868; border-radius: 4px; flex: 1; min-width: 150px; min-width: 100px;\">\n    <button onclick=\"sendCmd('set_location')\" style=\"background: #bb9af7; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer;\"><i class=\"fa fa-map-marker\"></i> SET KOORDINAT BARU</button>\n  </div>\n  \n  <div style=\"display: flex; gap: 10px; margin-top: 15px; flex-wrap: wrap;\">\n    <button onclick=\"sendCmd('disable_valve')\" style=\"background: #f7768e; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-lock\"></i> LOCK VALVE</button>\n    <button onclick=\"sendCmd('enable_valve')\" style=\"background: #9ece6a; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-unlock\"></i> UNLOCK VALVE</button>\n  </div>\n  \n  <div style=\"display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;\">\n    <button onclick=\"sendCmd('identify')\" style=\"background: #e0af68; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-lightbulb-o\"></i> IDENTIFY NODE (BLINK WHITE)</button>\n    <button onclick=\"sendCmd('force_update')\" style=\"background: #7aa2f7; color: #1a1b26; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-download\"></i> FORCE OTA UPDATE</button>\n  </div>\n  <div style=\"display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;\">\n    <button onclick=\"if(confirm('Yakin mereset WiFi & LongLat? Alat akan offline.')) sendCmd('factory_reset')\" style=\"background: #f7768e; color: #ffffff; font-weight: bold; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; flex: 1; min-width: 150px;\"><i class=\"fa fa-warning\"></i> FACTORY RESET NODE</button>\n  </div>\n  \n  <p id=\"cmdResult\" style=\"margin-top: 15px; font-family: monospace; font-size: 12px; color: #bb9af7;\"></p>\n</div>\n\n<script>\n  function sendCmd(command) {\n    const target = document.getElementById('targetNode').value || 'all';\n    const resultBox = document.getElementById('cmdResult');\n    resultBox.innerText = `Sending command '${command}' to '${target}'...`;\n    resultBox.style.color = '#e0af68';\n    \n    fetch('http://localhost:5001/api/cmd', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ cmd: command, target_node: target, lat: document.getElementById('newLat').value, lon: document.getElementById('newLon').value })\n    })\n    .then(res => res.json())\n    .then(data => {\n      if (data.status === 'success') {\n        resultBox.innerText = `[SUCCESS] Command sent to MQTT broker!`;\n        resultBox.style.color = '#9ece6a';\n      } else {\n        resultBox.innerText = `[ERROR] ${data.error}`;\n        resultBox.style.color = '#f7768e';\n      }\n    })\n    .catch(err => {\n      resultBox.innerText = `[NETWORK ERROR] Could not connect to API at localhost:5000.`;\n      resultBox.style.color = '#f7768e';\n    });\n  }\n</script>\n"
      },
      "transparent": true
    },
    {
      "type": "geomap",
      "title": "\ud83d\uddfa\ufe0f Live Seismic Map (Epicenter & Sensor Node)",
      "gridPos": {
        "h": 13,
