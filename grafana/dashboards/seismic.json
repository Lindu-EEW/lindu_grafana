        {
          "refId": "A",
          "rawSql": "SELECT count(DISTINCT node_id) AS count FROM sensor_status WHERE node_id IN ($node_id) AND status <> 'offline' AND time > NOW() - INTERVAL '1 minute'",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lindu_pg"
          }
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lindu_pg"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {}
